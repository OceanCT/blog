<article class="note-card" data-search="<%= [post.title, post.description || '', post.tags.map(t => t.name).join(' ')].join(' ').toLowerCase() %>"><div class="note-meta"><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time><% post.tags.each(function(tag) { %><span><%= tag.name %></span><% }); %></div><h3><a href="<%- url_for(post.path) %>"><%= post.title %><span aria-hidden="true">↗</span></a></h3><p><%= post.description || truncate(strip_html(post.excerpt || post.content), {length: 140}) %></p><a class="read-link" href="<%- url_for(post.path) %>">阅读笔记 →</a></article>