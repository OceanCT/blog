<% const column = note_columns().find(item => item.posts.some(post => post.path === page.path)); const chapterIndex = column ? column.posts.findIndex(post => post.path === page.path) : -1; const previousChapter = column && column.posts[chapterIndex - 1]; const nextChapter = column && column.posts[chapterIndex + 1]; %>
<div class="post-back"><a href="<%- url_for(column ? column.path : '/columns/') %>">← <%= column ? column.title + ' 专栏' : '全部专栏' %></a></div><article class="post"><header class="post-header"><div class="eyebrow"><time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY.MM.DD') %></time> / LEARNING NOTES</div><h1><%= page.title %></h1><% if (page.description) { %><p class="post-description"><%= page.description %></p><% } %><div class="post-tags"><% page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>"><%= tag.name %></a><% }); %></div></header><div class="post-grid"><div class="prose"><%- page.content %></div><aside class="toc"><div class="side-label">ON THIS PAGE</div><%- toc(page.content, {list_number: false}) %></aside></div><nav class="post-navigation" aria-label="专栏阅读顺序"><% if(previousChapter) { %><a href="<%- url_for(previousChapter.path) %>"><span>← 上一篇</span><br><%= previousChapter.title %></a><% } %><% if(column) { %><a href="<%- url_for(column.path) %>">专栏目录<br><%= chapterIndex + 1 %> / <%= column.posts.length %></a><% } %><% if(nextChapter) { %><a href="<%- url_for(nextChapter.path) %>"><span>下一篇 →</span><br><%= nextChapter.title %></a><% } %></nav></article>