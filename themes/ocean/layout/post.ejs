<div class="post-back"><a href="<%- url_for('/') %>">← 全部笔记</a></div><article class="post"><header class="post-header"><div class="eyebrow"><time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY.MM.DD') %></time> / LEARNING NOTES</div><h1><%= page.title %></h1><% if (page.description) { %><p class="post-description"><%= page.description %></p><% } %><div class="post-tags"><% page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>"><%= tag.name %></a><% }); %></div></header><div class="post-grid"><div class="prose"><%- page.content %></div><aside class="toc"><div class="side-label">ON THIS PAGE</div><%- toc(page.content, {list_number: false}) %></aside></div><nav class="post-navigation" aria-label="相邻笔记"><% if(page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %><% if(page.next) { %><a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %></nav></article>